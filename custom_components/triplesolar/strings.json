{
  "config": {
    "step": {
      "user": {
        "title": "Connect Triple Solar heat pump",
        "menu_options": {
          "modbus_tls": "Local – Modbus TLS (recommended)",
          "modbus_tcp": "Local – Modbus TCP (unencrypted)",
          "cloud": "myTripleSolar cloud (energy counters)"
        }
      },
      "modbus_tls": {
        "title": "Pair via Modbus TLS",
        "description": "1. Connect the heat pump to your LAN by cable.\n2. In myTripleSolar enable **pairing mode** (it stays open for one minute).\n3. Press Submit right away – Home Assistant looks for the heat pump via mDNS and pairs.",
        "data": {
          "modules": "Heat pump modules"
        },
        "data_description": {
          "modules": "2 for a PVT heat pump 5.0 Duo (cascade)."
        }
      },
      "pairing_failed": {
        "title": "Pairing failed",
        "description": "Re-enable pairing mode in myTripleSolar, then press Submit to try again."
      },
      "tls_host": {
        "title": "Heat pump address",
        "description": "Paired with {hostname}, but its Modbus TLS service was not found via mDNS. Enter its IP address (e.g. from your router).",
        "data": {
          "host": "Host",
          "port": "Port"
        }
      },
      "modbus_tcp": {
        "title": "Modbus TCP",
        "description": "Unencrypted Modbus TCP must first be enabled in myTripleSolar (I/O → Modbus TCP mode: Insecure). Use only in an isolated network.",
        "data": {
          "host": "Host",
          "port": "Port",
          "unit_id": "Unit ID",
          "modules": "Heat pump modules"
        }
      },
      "cloud": {
        "title": "myTripleSolar",
        "description": "Unofficial interface of the myTripleSolar web app. Read-only.",
        "data": {
          "email": "E-mail",
          "password": "Password"
        }
      },
      "cloud_select": {
        "title": "Choose heat pump",
        "data": {
          "heat_pump_id": "Heat pump"
        }
      },
      "reauth_confirm": {
        "title": "Sign in again",
        "description": "Password for {email}",
        "data": {
          "password": "Password"
        }
      }
    },
    "progress": {
      "pairing": "Looking for the heat pump in pairing mode (up to 45 s)…"
    },
    "error": {
      "cannot_connect": "Cannot connect",
      "invalid_auth": "Invalid credentials",
      "no_heat_pumps": "No heat pump in this account",
